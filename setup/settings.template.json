{
    "workbench.colorTheme": "Midnight Glass",
    "workbench.preferredDarkColorTheme": "Midnight Glass",
    "workbench.iconTheme": "vscode-icons",
    "window.autoDetectColorScheme": true,
    "window.systemColorTheme": "dark",
    "terminal.integrated.gpuAcceleration": "off",

    "vscode_vibrancy.theme": "Custom theme (use imports)",
    "vscode_vibrancy.preferredDarkTheme": "Custom theme (use imports)",
    "vscode_vibrancy.enableAutoTheme": true,
    "vscode_vibrancy.opacity": 0.2,
    "vscode_vibrancy.disableFramelessWindow": true,
    "vscode_vibrancy.imports": [
        "{{STYLES_DIR}}/midnight-glass.css",
        "{{STYLES_DIR}}/midnight-glass.json"
    ],

    "animations.Install-Method": "Custom UI Style",
    "animations.CursorAnimation": true,
    "animations.UseCursorColorForCursorAnimation": true,
    "custom-ui-style.external.imports": [
        "file:///{{ANIMATIONS_DIR}}/dist/updateHandler.js"
    ],

    "workbench.colorCustomizations": {
        "[Midnight Glass]": {
            "editorPane.background": "#1b1b1b00",
            "editorGroupHeader.tabsBackground": "#1b1b1b00",
            "editorGroupHeader.noTabsBackground": "#1b1b1b00",
            "breadcrumb.background": "#1b1b1b00",
            "editorGutter.background": "#1b1b1b00",
            "minimap.background": "#1b1b1b00",
            "editorOverviewRuler.background": "#1b1b1b00",
            "panel.background": "#21212100",
            "terminal.background": "#21212100",
            "tab.activeBackground": "#1b1b1b00",
            "tab.unfocusedActiveBackground": "#1b1b1b00",
            "sideBar.background": "#22222233",
            "sideBarTitle.background": "#22222233",
            "sideBarSectionHeader.background": "#22222200",
            "activityBar.background": "#21212133",
            "titleBar.activeBackground": "#21212133",
            "titleBar.inactiveBackground": "#21212133",
            "statusBar.background": "#21212133",
            "editor.background": "#1b1b1b33",
            "tab.inactiveBackground": "#22222233",
            "tab.unfocusedInactiveBackground": "#22222233",
            "editorStickyScroll.background": "#1b1b1bbf",
            "editorStickyScrollGutter.background": "#1b1b1bbf",
            "sideBarStickyScroll.background": "#222222bf",
            "panelStickyScroll.background": "#21212100",
            "chat.requestBackground": "#1b1b1b80",
            "inlineChat.background": "#1b1b1be6",
            "editorWidget.background": "#1b1b1be6",
            "editorHoverWidget.background": "#1b1b1be6",
            "editorSuggestWidget.background": "#1b1b1be6",
            "notifications.background": "#1b1b1be6",
            "notificationCenterHeader.background": "#1b1b1be6",
            "menu.background": "#1b1b1be6",
            "quickInput.background": "#1b1b1be6"
        }
    }
}
